# Dependencies & build
node_modules
dist
dist-ssr
coverage
*.tsbuildinfo

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
credentials.json
**/secrets/
**/secret/

# Local-only strategy / brand notes — never publish (see private/README.md)
# Ignore contents, not the directory itself, so README can be force-tracked.
/private/*
!/private/README.md

# Local overrides / caches
*.local
.cache
.temp
.tmp

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tauri / packaging
src-tauri/target

# Local test / scratch artifacts (may contain machine paths)
test-results/
playwright-report/
tmp*.txt
tmp*.log
