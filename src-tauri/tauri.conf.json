{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WVC-CAD",
  "version": "0.1.0",
  "identifier": "com.wvccad.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "WVC-CAD",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "WVC-CAD",
    "copyright": "Copyright © 2026 WVC-CAD contributors",
    "license": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "Parametric 2D mechanical sketcher",
    "longDescription": "WVC-CAD is a focused parametric 2D mechanical sketcher: create geometry, apply constraints, solve, and save versioned .sketch.json files. No accounts, cloud sync, or analytics.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
